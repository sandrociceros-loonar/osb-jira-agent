environment                        = "dev"
subscription_id                    = "<azure-subscription-id>"
location                           = "eastus2"
resource_group_name                = "rg-osb-jira-agent-dev"
prefix                             = "osbjira"
azure_ai_model_deployment_name     = "gpt-5"
azure_ai_model_name                = "gpt-5"
azure_ai_model_version             = "2025-08-07"
azure_ai_model_capacity            = 50
jira_instance_url                  = "https://your-company.atlassian.net"
jira_project_key                   = "ITSM"
jira_allowed_project_keys          = ["ITSM", "OP"]
jira_lead_project_key              = "OP"
jira_lead_issue_type_id            = "12716"
jira_manufacturer_field_id         = ""
jira_skip_manufacturer_update_if_not_editable = false
jira_enable_write_operations       = false
jira_webhook_secret_header         = "X-Atlassian-Webhook-Secret"
jira_assets_access_token           = ""
jira_assets_cloud_id               = ""
jira_assets_workspace_id           = ""
jira_assets_product_object_type_id = "157"
azure_ai_max_tool_calls            = 16
jira_attachment_max_bytes          = 65536
log_level                          = "INFO"
jira_debug_log_content             = false
jira_debug_log_content_issue_key   = ""
jira_debug_log_content_until       = ""
jira_transition_ids = {
  start_lead_work                  = "2"
  transition_lead_to_proposal_item = "21"
  generate_new_proposal            = "3"
  send_item_to_purchasing          = "12"
  set_proposal_item_price          = "7"
}
# Required: Jira email and API token are reused by Confluence when its overrides are blank.
jira_api_email        = ""
jira_api_token        = ""
jira_team_account_ids = {}
# Required: generate a separate random secret (at least 32 characters) for Jira Webhooks.
jira_webhook_secret   = ""

confluence_space_url             = "https://loonar-osb.atlassian.net/wiki/spaces/osbjiraage"
confluence_base_url              = "https://loonar-osb.atlassian.net/wiki"
confluence_space_key             = "osbjiraage"
# Reuses jira_api_email and jira_api_token when empty.
confluence_api_email             = ""
confluence_api_token             = ""
# Required: generate a separate random secret (at least 32 characters) for Confluence Automation.
confluence_webhook_secret        = ""
confluence_webhook_secret_header = "X-Atlassian-Webhook-Secret"

tags = {
  Project     = "OSB-Jira-Agent"
  Environment = "dev"
  ManagedBy   = "Terraform"
}
