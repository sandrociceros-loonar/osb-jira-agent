# Model provider: "azure", "foundry-local" or "ollama"
MODEL_PROVIDER="azure"

# Used when MODEL_PROVIDER="azure"; copied from the Foundry project overview
AZURE_AI_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4o"
AZURE_AI_MAX_TOOL_CALLS="16"

# Used when MODEL_PROVIDER="foundry-local"
FOUNDRY_LOCAL_MODEL_ALIAS="phi-4-mini"
FOUNDRY_LOCAL_BASE_URL="http://127.0.0.1:5273/v1"

# Used when MODEL_PROVIDER="ollama"
OLLAMA_MODEL_NAME="qwen3:4b"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"

# Jira Webhook Security
# Shared secret configured in Jira Webhook headers to ensure payload authenticity
JIRA_WEBHOOK_SECRET="your-jira-webhook-shared-secret"
# Header name used by Jira (common: X-Atlassian-Webhook-Secret or X-Hub-Signature)
JIRA_WEBHOOK_SECRET_HEADER="X-Atlassian-Webhook-Secret"

# Jira Service Management Context
JIRA_INSTANCE_URL="https://your-domain.atlassian.net"
JIRA_PROJECT_KEY="ITSM"
JIRA_ALLOWED_PROJECT_KEYS='["ITSM","OP"]'
JIRA_LEAD_PROJECT_KEY="OP"
JIRA_LEAD_ISSUE_TYPE_ID="12716"
# Destructive/write tools and automatic triage write-back are disabled by default
JIRA_ENABLE_WRITE_OPERATIONS="false"
# Confirm these workflow-specific IDs in your Jira before enabling writes
JIRA_TRANSITION_IDS='{"start_lead_work":"2","transition_lead_to_proposal_item":"21","generate_new_proposal":"3","send_item_to_purchasing":"12","set_proposal_item_price":"7"}'
# Jira Cloud API credentials (leave blank to disable write-back locally)
JIRA_API_EMAIL=""
JIRA_API_TOKEN=""
# Optional mapping from suggested team names to Jira Cloud account IDs
JIRA_TEAM_ACCOUNT_IDS="{}"
# Optional OAuth Bearer token for Assets; otherwise the Jira API token is used
JIRA_ASSETS_ACCESS_TOKEN=""
# Optional overrides; Cloud ID and a unique Assets workspace are discovered when omitted
JIRA_ASSETS_CLOUD_ID=""
JIRA_ASSETS_WORKSPACE_ID=""
JIRA_ASSETS_PRODUCT_OBJECT_TYPE_ID="157"
JIRA_ATTACHMENT_MAX_BYTES="65536"

# Application Settings
LOG_LEVEL="INFO"
ENVIRONMENT="development"
