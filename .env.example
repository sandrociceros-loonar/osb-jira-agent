# Azure AI Foundry Configuration
# The connection string can be found in your Azure AI Foundry Project Overview
# Format: <Endpoint>;<SubscriptionId>;<ResourceGroup>;<ProjectName>
AZURE_AI_PROJECT_CONNECTION_STRING="eastus2.api.azureml.ms;00000000-0000-0000-0000-000000000000;rg-osb-jira-agent;proj-jira-triage"

# Optional: Specific Agent ID if pre-created in Foundry Studio, or leave empty to create/get by name
AZURE_AI_AGENT_ID=""
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4o"

# Jira Webhook Security
# Shared secret configured in Jira Webhook headers to ensure payload authenticity
JIRA_WEBHOOK_SECRET="your-jira-webhook-shared-secret"
# Header name used by Jira (common: X-Atlassian-Webhook-Secret or X-Hub-Signature)
JIRA_WEBHOOK_SECRET_HEADER="X-Atlassian-Webhook-Secret"

# Jira Service Management Context
JIRA_INSTANCE_URL="https://your-domain.atlassian.net"
JIRA_PROJECT_KEY="ITSM"

# Application Settings
LOG_LEVEL="INFO"
ENVIRONMENT="development"
